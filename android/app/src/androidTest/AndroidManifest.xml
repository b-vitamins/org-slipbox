<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AGP supplies the configured runner name to the first instrumentation. -->
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="io.github.b_vitamins.slipbox.debug" />

    <!-- Live consent runs only when this instrumentation is explicitly named. -->
    <instrumentation
        android:name="io.github.b_vitamins.slipbox.auth.manual.LiveAuthorizationJourney"
        android:targetPackage="io.github.b_vitamins.slipbox.debug" />

    <!-- Explicit invocation only; not part of the connected test suite. -->
    <instrumentation
        android:name="io.github.b_vitamins.slipbox.github.manual.LiveProviderJourney"
        android:targetPackage="io.github.b_vitamins.slipbox.debug" />

</manifest>
